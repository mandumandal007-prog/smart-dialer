<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Recents"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton style="@style/FilterChip" android:id="@+id/filter_all" android:text="All" />
        <androidx.appcompat.widget.AppCompatButton style="@style/FilterChip" android:id="@+id/filter_missed" android:text="Missed" />
        <androidx.appcompat.widget.AppCompatButton style="@style/FilterChip" android:id="@+id/filter_incoming" android:text="In" />
        <androidx.appcompat.widget.AppCompatButton style="@style/FilterChip" android:id="@+id/filter_outgoing" android:text="Out" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recents_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/recents_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No calls yet"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
